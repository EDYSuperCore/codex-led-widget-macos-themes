{
  "name": "codex-led-widget",
  "version": "0.1.3",
  "description": "Cross-platform desktop LED widget for showing local Codex usage quota.",
  "main": "src/main/main.js",
  "author": "Codex Quota Widget Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "debug:quota": "node scripts/debug-quota.js",
    "test:sanitize": "node scripts/test-sanitize.js",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "build:win": "electron-builder --win portable --x64",
    "build:win:arm64": "electron-builder --win portable --arm64"
  },
  "build": {
    "appId": "cn.codex.quota.widget",
    "productName": "Codex Quota Widget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Codex-Quota-Widget-${version}-mac-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Codex-Quota-Widget-${version}-win-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
